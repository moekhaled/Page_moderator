APP_NAME="Page Moderator Backend"
DEBUG=false
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/page_moderator"
META_VERIFY_TOKEN="replace-with-your-verify-token"
META_APP_SECRET="replace-with-your-meta-app-secret"
META_PAGE_ACCESS_TOKEN="replace-with-page-access-token"
META_GRAPH_VERSION="v23.0"
INSTAGRAM_BUSINESS_ACCOUNT_ID="replace-with-your-page-or-ig-business-id"
MODERATOR_SHARED_PASSWORD="replace-with-shared-password"
SESSION_SECRET_KEY="replace-with-random-session-secret"
RETENTION_DAYS=90
RAW_EVENT_RETENTION_DAYS=14
TIMEZONE_NAME="Africa/Cairo"

LLM_ENABLED=true
LLM_SHADOW_MODE=true
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-flash"
LLM_TIMEOUT_SECONDS=20
LLM_HISTORY_LIMIT=20
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2
LLM_ALLOWED_AUTOREPLY_INTENTS="price_inquiry"
LLM_PRICE_INQUIRY_MIN_CONFIDENCE=0.8
GEMINI_API_KEY=""
OPENAI_API_KEY=""

POLICY_REQUIRE_WHATSAPP_VERIFICATION=true
POLICY_REQUIRE_DEPOSIT_VERIFICATION=true
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=20
OUTBOUND_MAX_ATTEMPTS=5
GLOBAL_LLM_PAUSED=false
